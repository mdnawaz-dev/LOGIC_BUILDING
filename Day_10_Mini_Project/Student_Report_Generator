/*
Question:
const student = [
    {name: "Nawaz", Marks: 85},
    {name: "Ahmed", Marks: 42},
    {name: "Sara", Marks: 91},
    {name: "Zaid", Marks: 38},
    {name: "Ali", Marks: 75}
];

Generate a Full Report:
- Total students
- Passed and failed count
- Highest scorer name
- Print result card for each student with pass/fail status
*/

// Data
const student = [
    { name: "Nawaz", Marks: 85 },
    { name: "Ahmed", Marks: 42 },
    { name: "Sara", Marks: 91 },
    { name: "Zaid", Marks: 38 },
    { name: "Ali", Marks: 75 }
];

// Function
function GenerateReport(studentList) {

    const totalStudents = studentList.length;

    const passedCount = studentList.filter(student => student.Marks >= 40).length;

    const failedCount = totalStudents - passedCount;

    const higherScorer = studentList.reduce((topStudent, currentStudent) => {
        return currentStudent.Marks > topStudent.Marks
            ? currentStudent
            : topStudent;
    });

    console.log("==== Batch Report ====");
    console.log(`Total Students : ${totalStudents}`);
    console.log(`Passed Students: ${passedCount}`);
    console.log(`Failed Students: ${failedCount}`);
    console.log(
        `Highest Scorer: ${higherScorer.name} with ${higherScorer.Marks} marks`
    );

    console.log("\n==== Result Cards ====");

    studentList.forEach(student => {
        const status = student.Marks >= 40 ? "Pass ✅" : "Fail ❌";

        console.log(
            `Name: ${student.name.padEnd(8)} | Marks: ${student.Marks
                .toString()
                .padEnd(2)} | Status: ${status}`
        );
    });
}

// Function Call
GenerateReport(student);

